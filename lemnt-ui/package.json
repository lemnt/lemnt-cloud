{
  "name": "lemnt-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=22.13.0 <23.0.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "format:check": "prettier --check src vite.config.ts tsconfig.json package.json eslint.config.js prettier.config.js",
    "format": "prettier --write src vite.config.ts tsconfig.json package.json eslint.config.js prettier.config.js",
    "build": "tsc -b && vite build",
    "build:prod": "tsc -b && vite build",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@ant-design/pro-components": "3.1.15-3",
    "@tanstack/react-query": "^5.104.0",
    "antd": "^6.6.5",
    "axios": "^1.20.0",
    "dompurify": "^3.4.16",
    "quill": "^2.0.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
