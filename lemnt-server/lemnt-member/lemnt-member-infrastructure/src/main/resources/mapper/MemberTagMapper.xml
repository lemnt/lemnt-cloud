<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lemnt.member.infrastructure.user.mapper.MemberTagMapper">
    <resultMap id="TagMap" type="com.lemnt.member.infrastructure.user.dataobject.TagDO">
        <id column="id" property="id"/><result column="name" property="name"/>
        <result column="remark" property="remark"/>
        <result column="create_time" property="createTime"/><result column="create_by" property="createBy"/>
        <result column="update_time" property="updateTime"/><result column="update_by" property="updateBy"/>
    </resultMap>
    <delete id="tagDelete">
        DELETE FROM member_tag WHERE id=#{id} AND NOT EXISTS(SELECT 1 FROM member_tag_link WHERE tag_id=#{id})
    </delete>
</mapper>
