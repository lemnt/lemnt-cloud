<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lemnt.member.infrastructure.user.mapper.MemberGroupMapper">
    <resultMap id="GroupMap" type="com.lemnt.member.infrastructure.user.dataobject.GroupDO">
        <id column="id" property="id"/><result column="name" property="name"/>
        <result column="remark" property="remark"/><result column="status" property="status"/>
        <result column="create_time" property="createTime"/><result column="create_by" property="createBy"/>
        <result column="update_time" property="updateTime"/><result column="update_by" property="updateBy"/>
    </resultMap>
    <delete id="groupDelete">
        DELETE FROM member_group WHERE id=#{id} AND NOT EXISTS(SELECT 1 FROM member_user WHERE group_id=#{id})
    </delete>
</mapper>
