<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lemnt.member.infrastructure.growth.mapper.MemberPointRecordMapper">
 <resultMap id="PointMap" type="com.lemnt.member.infrastructure.growth.dataobject.PointRecordDO">
  <id column="id" property="id"/><result column="user_id" property="userId"/><result column="biz_id" property="bizId"/>
  <result column="biz_type" property="bizType"/><result column="title" property="title"/><result column="description" property="description"/>
  <result column="point" property="point"/><result column="total_point" property="totalPoint"/>
  <result column="biz_code" property="bizCode"/><result column="reason" property="reason"/><result column="create_time" property="createTime"/>
  <result column="create_by" property="createBy"/><result column="update_by" property="updateBy"/><result column="update_time" property="updateTime"/>
  <result column="nickname" property="nickname"/>
 </resultMap>
 <sql id="Conditions"><where>
  <if test="f.memberId != null">p.user_id=#{f.memberId}</if>
  <if test="f.nickname != null">AND m.nickname LIKE CONCAT('%',#{f.nickname},'%')</if>
  <if test="f.bizType != null">AND p.biz_code=#{f.bizType}</if>
  <if test="f.pointBizType != null">AND p.biz_type=#{f.pointBizType}</if>
  <if test="f.title != null">AND p.title LIKE CONCAT('%',#{f.title},'%')</if>
  <if test="f.startTime != null">AND p.create_time &gt;= #{f.startTime}</if>
  <if test="f.endTime != null">AND p.create_time &lt;= #{f.endTime}</if>
  <if test="f.addStatus != null and f.addStatus">AND p.point &gt; 0</if>
  <if test="f.addStatus != null and !f.addStatus">AND p.point &lt; 0</if>
 </where></sql>
 <select id="page" resultMap="PointMap">SELECT p.*,m.nickname FROM member_point_record p LEFT JOIN member_user m ON m.id=p.user_id
 <include refid="Conditions"/> ORDER BY p.id DESC LIMIT #{f.limit} OFFSET #{f.offset}</select>
 <select id="count" resultType="long">SELECT COUNT(*) FROM member_point_record p LEFT JOIN member_user m ON m.id=p.user_id <include refid="Conditions"/></select>
</mapper>
