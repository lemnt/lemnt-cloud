<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lemnt.product.infrastructure.product.mapper.ProductStockReservationMapper">
    <resultMap id="ProductStockReservationResult"
               type="com.lemnt.product.infrastructure.product.dataobject.ProductStockReservationDO"
               autoMapping="false">
        <id property="id" column="id"/>
        <result property="reservationNo" column="reservation_no"/>
        <result property="sourceNo" column="source_no"/>
        <result property="productId" column="product_id"/>
        <result property="quantity" column="quantity"/>
        <result property="status" column="status"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <sql id="baseColumn">
        id, reservation_no, source_no, product_id, quantity, status, create_by, create_time, update_by, update_time
    </sql>

    <select id="lock" resultMap="ProductStockReservationResult" useCache="false" flushCache="true">
        SELECT
        <include refid="baseColumn"/>
        FROM product_stock_reservation
        WHERE reservation_no=#{key} AND product_id=#{skuId} FOR UPDATE
    </select>
</mapper>
