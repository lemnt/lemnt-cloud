<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lemnt.order.infrastructure.fulfillment.mapper.ShipmentMapper">
    <update id="receive">
        UPDATE order_shipment SET received_at=#{time} WHERE order_no=#{orderNo} AND received_at IS NULL
    </update>
</mapper>
