<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lemnt.mall.infrastructure.product.mapper.ProductSkuMapper">

    <resultMap id="ProductSkuResult" type="com.lemnt.mall.infrastructure.product.dataobject.ProductSkuDO" autoMapping="false">
        <id property="id" column="id"/>
        <result property="spuId" column="spu_id"/>
        <result property="properties" column="properties"/>
        <result property="variantKey" column="variant_key"/>
        <result property="productCode" column="product_code"/>
        <result property="name" column="name"/>
        <result property="description" column="description"/>
        <result property="mainImage" column="main_image"/>
        <result property="price" column="price"/>
        <result property="stock" column="stock"/>
        <result property="status" column="status"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="weight" column="weight"/>
        <result property="volume" column="volume"/>
    </resultMap>



    <sql id="productSellable">
        (spu_id IS NULL OR EXISTS (SELECT 1 FROM mall_product_spu s JOIN mall_product_category c ON c.id=s.category_id JOIN
        mall_product_brand b ON b.id=s.brand_id LEFT JOIN mall_product_category parent ON parent.id=c.parent_id WHERE
        s.id=mall_product_sku.spu_id AND s.status='ON_SHELF' AND c.status='ENABLED' AND b.status='ENABLED' AND
        (c.parent_id IS NULL OR parent.status='ENABLED')))
    </sql>



    <select id="lockById" resultMap="ProductSkuResult"
            flushCache="true" useCache="false">
        SELECT * FROM mall_product_sku WHERE id=#{id} FOR UPDATE
    </select>

    <select id="findSellableByIds" resultMap="ProductSkuResult">
        SELECT * FROM mall_product_sku WHERE status='ON_SHELF' AND
        <include refid="productSellable"/>
        AND id IN
        <foreach collection='ids' item='id' open='(' separator=',' close=')'>#{id}</foreach>
    </select>

    <select id="findSellableById" resultMap="ProductSkuResult">
        SELECT * FROM mall_product_sku WHERE id=#{id} AND status='ON_SHELF' AND
        <include refid="productSellable"/>
    </select>

    <update id="reserveStock">
        UPDATE mall_product_sku SET stock=stock-#{quantity},update_time=CURRENT_TIMESTAMP WHERE id=#{id} AND
        status='ON_SHELF' AND stock>=#{quantity} AND
        <include refid="productSellable"/>
    </update>
</mapper>
