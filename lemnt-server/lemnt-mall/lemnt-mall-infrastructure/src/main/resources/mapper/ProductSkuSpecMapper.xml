<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lemnt.mall.infrastructure.product.mapper.ProductSkuSpecMapper">

    <resultMap id="ProductSkuSpecResult" type="com.lemnt.mall.infrastructure.product.dataobject.ProductSkuSpecDO" autoMapping="false">
        <id property="productId" column="product_id"/>
        <id property="propertyName" column="property_name"/>
        <result property="propertyValue" column="property_value"/>
    </resultMap>

    <select id="propertiesBySpu" resultMap="ProductSkuSpecResult">
        SELECT p.* FROM mall_product_sku_spec p JOIN mall_product_sku s ON s.id=p.product_id WHERE s.spu_id=#{id}
        ORDER BY p.property_name
    </select>
</mapper>
