<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lemnt.mall.infrastructure.promotion.mapper.PromotionOrderMapper">

    <select id="lockByOrderNo" resultType="com.lemnt.mall.infrastructure.promotion.dataobject.PromotionOrderDO"
            flushCache="true" useCache="false">
        SELECT * FROM mall_promotion_order WHERE order_no=#{orderNo} FOR UPDATE
    </select>
</mapper>
