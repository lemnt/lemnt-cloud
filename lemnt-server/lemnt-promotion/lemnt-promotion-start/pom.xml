<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.lemnt</groupId>
        <artifactId>lemnt-promotion</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>
    <artifactId>lemnt-promotion-start</artifactId>
    <dependencies>
        <dependency>
            <groupId>com.lemnt</groupId>
            <artifactId>lemnt-promotion-adapter</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>com.lemnt</groupId>
            <artifactId>lemnt-promotion-infrastructure</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>com.lemnt</groupId>
            <artifactId>lemnt-common-start</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>com.lemnt</groupId>
            <artifactId>lemnt-common-metrics</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>com.lemnt</groupId>
            <artifactId>lemnt-common-sql</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>
        <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-test</artifactId><scope>test</scope></dependency>
        <dependency><groupId>com.h2database</groupId><artifactId>h2</artifactId><scope>test</scope></dependency>
        <dependency>
            <groupId>com.lemnt</groupId>
            <artifactId>lemnt-product-application</artifactId>
            <version>1.0.0-SNAPSHOT</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.lemnt</groupId>
            <artifactId>lemnt-product-infrastructure</artifactId>
            <version>1.0.0-SNAPSHOT</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <testResources>
            <testResource><directory>../sql</directory><targetPath>promotion-sql</targetPath></testResource>
            
            <testResource><directory>../../sql</directory><targetPath>setup-sql</targetPath></testResource>
        <testResource><directory>../../lemnt-product/sql</directory><targetPath>product-sql</targetPath></testResource></testResources>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
