<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lemnt.pay.infrastructure.payment.mapper.WalletRechargeMapper">
    <select id="lockByNo" resultType="com.lemnt.pay.infrastructure.payment.dataobject.WalletRechargeDO" useCache="false"
            flushCache="true">
        SELECT * FROM pay_wallet_recharge WHERE recharge_no=#{rechargeNo} FOR UPDATE
    </select>

    <select id="databaseNow" resultType="java.time.LocalDateTime">
        SELECT CURRENT_TIMESTAMP
    </select>
</mapper>
