<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.lemnt</groupId>
        <artifactId>lemnt-pay</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>
    <artifactId>lemnt-pay-start</artifactId>
    <dependencies>
        <dependency>
            <groupId>com.lemnt</groupId>
            <artifactId>lemnt-pay-adapter</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>com.lemnt</groupId>
            <artifactId>lemnt-pay-infrastructure</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>com.lemnt</groupId>
            <artifactId>lemnt-common-start</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>com.lemnt</groupId>
            <artifactId>lemnt-common-metrics</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>com.lemnt</groupId>
            <artifactId>lemnt-common-sql</artifactId>
            <version>1.0.0-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <testResources>
            <testResource>
                <directory>../sql</directory>
                <targetPath>pay-sql</targetPath>
            </testResource>

            <testResource>
                <directory>../../sql</directory>
                <targetPath>setup-sql</targetPath>
                <includes>
                    <include>V20261025__mall_checkout_menu.sql</include>
                    <include>V20261028__trade_delivery_permissions.sql</include>
                    <include>V20261027__mall_shopping_ownership.sql</include>
                    <include>V20261025__trade_fulfillment_menu.sql</include>
                    <include>V20261026__mall_promotion_permissions.sql</include>
                    <include>V20261027__trade_payment_management_permissions.sql</include>
                    <include>V20261031__trade_payment_menu.sql</include>
                    <include>V20261031__trade_pay_config_menu.sql</include>
                    <include>V20261031__trade_pay_notify_menu.sql</include>
                    <include>V20261031__trade_wallet_menu.sql</include>
                    <include>V20261031__trade_recharge_menu.sql</include>
                    <include>V20261031__trade_wallet_transfer_menu.sql</include>
                    <include>V20261031__trade_delivery_config_menu.sql</include>
                    <include>V20261027__trade_fulfillment_management_permissions.sql</include>
                    <include>V20261101__trade_brokerage_menu.sql</include>
                    <include>V20261101__trade_pickup_menu.sql</include>
                    <include>V20261101__trade_pickup_verify_menu.sql</include>
                    <include>V20261101__trade_order_adjust_permissions.sql</include>
                </includes>
            </testResource>
        </testResources>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
