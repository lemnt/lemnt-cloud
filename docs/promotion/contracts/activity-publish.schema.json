{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lemnt:promotion:design:activity-publish",
  "title": "activity-publish（拟定，尚未实现）",
  "type": "object",
  "properties": {
    "requestNo": {
      "type": "string",
      "description": "幂等请求编号，重试不可改变",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "expectedRevision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647,
      "description": "当前修订号"
    }
  },
  "required": [
    "requestNo",
    "expectedRevision"
  ],
  "additionalProperties": false
}
