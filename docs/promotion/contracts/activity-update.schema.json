{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lemnt:promotion:design:activity-update",
  "title": "activity-update（T3后台本地验证；V2购买链路未接入）",
  "type": "object",
  "properties": {
    "requestNo": {
      "type": "string",
      "description": "幂等请求编号，重试不可改变",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "expectedRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647,
      "description": "读取到的当前修订号"
    },
    "draft": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "活动名称",
          "minLength": 1,
          "maxLength": 100
        },
        "type": {
          "type": "string",
          "enum": [
            "FULL_REDUCTION",
            "ORDER_DISCOUNT"
          ],
          "description": "活动类型"
        },
        "scope": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "ALL",
                "SPU_IDS",
                "SKU_IDS"
              ],
              "description": "商品范围"
            },
            "ids": {
              "type": "array",
              "items": {
                "type": "string",
                "description": "正整数ID，以字符串传递",
                "pattern": "^[1-9][0-9]{0,18}$",
                "format": "int64-positive"
              },
              "minItems": 0,
              "maxItems": 1000,
              "uniqueItems": true
            }
          },
          "required": [
            "kind",
            "ids"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "kind": {
                    "const": "ALL"
                  }
                }
              },
              "then": {
                "properties": {
                  "ids": {
                    "maxItems": 0
                  }
                }
              },
              "else": {
                "properties": {
                  "ids": {
                    "minItems": 1
                  }
                }
              }
            }
          ]
        },
        "audience": {
          "const": "ALL_AUTHENTICATED",
          "description": "首期仅有效登录会员"
        },
        "couponPolicy": {
          "type": "string",
          "enum": [
            "EXCLUSIVE",
            "ALLOW_ONE"
          ],
          "description": "是否允许一张指定券"
        },
        "priority": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000,
          "description": "同价且资源数相同时优先级越大越优先"
        },
        "startsAtEpochMs": {
          "type": "string",
          "description": "UTC epoch毫秒，十进制字符串",
          "pattern": "^[1-9][0-9]{0,18}$",
          "format": "int64-positive"
        },
        "endsAtEpochMs": {
          "type": "string",
          "description": "UTC epoch毫秒，十进制字符串",
          "pattern": "^[1-9][0-9]{0,18}$",
          "format": "int64-positive"
        },
        "globalUseLimit": {
          "anyOf": [
            {
              "type": "string",
              "description": "正整数次数，最大Long.MAX_VALUE",
              "pattern": "^[1-9][0-9]{0,18}$",
              "format": "int64-positive"
            },
            {
              "type": "null"
            }
          ],
          "description": "总使用次数上限，正整数字符串；null表示无限次数"
        },
        "memberUseLimit": {
          "anyOf": [
            {
              "type": "string",
              "description": "正整数次数，最大Long.MAX_VALUE",
              "pattern": "^[1-9][0-9]{0,18}$",
              "format": "int64-positive"
            },
            {
              "type": "null"
            }
          ],
          "description": "每会员使用次数上限，正整数字符串；null表示无限次数"
        },
        "rule": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "tiers": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "thresholdFen": {
                        "type": "string",
                        "description": "非负整数分，0..Long.MAX_VALUE",
                        "pattern": "^(0|[1-9][0-9]{0,18})$",
                        "format": "int64-nonnegative"
                      },
                      "discountFen": {
                        "type": "string",
                        "description": "非负整数分，0..Long.MAX_VALUE",
                        "pattern": "^[1-9][0-9]{0,18}$",
                        "format": "int64-positive"
                      }
                    },
                    "required": [
                      "thresholdFen",
                      "discountFen"
                    ],
                    "additionalProperties": false
                  },
                  "minItems": 1,
                  "maxItems": 20
                }
              },
              "required": [
                "tiers"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "thresholdFen": {
                  "type": "string",
                  "description": "非负整数分，0..Long.MAX_VALUE",
                  "pattern": "^(0|[1-9][0-9]{0,18})$",
                  "format": "int64-nonnegative"
                },
                "payRateBps": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9999,
                  "description": "支付比例，8000=支付80%；优惠额向下取分"
                },
                "maxDiscountFen": {
                  "anyOf": [
                    {
                      "type": "string",
                      "description": "非负整数分，0..Long.MAX_VALUE",
                      "pattern": "^[1-9][0-9]{0,18}$",
                      "format": "int64-positive"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "thresholdFen",
                "payRateBps",
                "maxDiscountFen"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "name",
        "type",
        "scope",
        "audience",
        "couponPolicy",
        "priority",
        "startsAtEpochMs",
        "endsAtEpochMs",
        "globalUseLimit",
        "memberUseLimit",
        "rule"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "FULL_REDUCTION"
              }
            }
          },
          "then": {
            "properties": {
              "rule": {
                "type": "object",
                "properties": {
                  "tiers": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "thresholdFen": {
                          "type": "string",
                          "description": "非负整数分，0..Long.MAX_VALUE",
                          "pattern": "^(0|[1-9][0-9]{0,18})$",
                          "format": "int64-nonnegative"
                        },
                        "discountFen": {
                          "type": "string",
                          "description": "非负整数分，0..Long.MAX_VALUE",
                          "pattern": "^[1-9][0-9]{0,18}$",
                          "format": "int64-positive"
                        }
                      },
                      "required": [
                        "thresholdFen",
                        "discountFen"
                      ],
                      "additionalProperties": false
                    },
                    "minItems": 1,
                    "maxItems": 20
                  }
                },
                "required": [
                  "tiers"
                ],
                "additionalProperties": false
              }
            }
          },
          "else": {
            "properties": {
              "rule": {
                "type": "object",
                "properties": {
                  "thresholdFen": {
                    "type": "string",
                    "description": "非负整数分，0..Long.MAX_VALUE",
                    "pattern": "^(0|[1-9][0-9]{0,18})$",
                    "format": "int64-nonnegative"
                  },
                  "payRateBps": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9999,
                    "description": "支付比例，8000=支付80%；优惠额向下取分"
                  },
                  "maxDiscountFen": {
                    "anyOf": [
                      {
                        "type": "string",
                        "description": "非负整数分，0..Long.MAX_VALUE",
                        "pattern": "^[1-9][0-9]{0,18}$",
                        "format": "int64-positive"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "thresholdFen",
                  "payRateBps",
                  "maxDiscountFen"
                ],
                "additionalProperties": false
              }
            }
          }
        }
      ]
    }
  },
  "required": [
    "requestNo",
    "expectedRevision",
    "draft"
  ],
  "additionalProperties": false
}
