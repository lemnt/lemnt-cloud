            "rule": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "tiers": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "thresholdFen": {
                            "type": "string",
                            "description": "非负整数分，0..Long.MAX_VALUE",
