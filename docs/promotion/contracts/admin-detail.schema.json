  "$id": "urn:lemnt:promotion:design:admin-detail",
  "title": "admin-detail（拟定，尚未实现）",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "正整数ID，以字符串传递",
      "pattern": "^[1-9][0-9]{0,18}$",
      "format": "int64-positive"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647,
      "description": "操作完成后的根修订号"
    },
    "state": {
      "type": "string",
      "enum": [
        "DRAFT",
        "PUBLISHED",
        "PAUSED",
        "ARCHIVED"
      ],
      "description": "持久状态；窗口阶段另算"
    },
    "activeVersion": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647,
          "description": "当前已发布版本"
        },
        {
          "type": "null"
        }
      ]
    },
    "code": {
      "type": "string",
      "description": "唯一活动编码",
      "minLength": 1,
      "maxLength": 64
    },
    "draft": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "description": "活动名称",
              "minLength": 1,
              "maxLength": 100
            },
            "type": {
              "type": "string",
              "enum": [
                "FULL_REDUCTION",
                "ORDER_DISCOUNT"
              ],
              "description": "活动类型"
            },
            "scope": {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "ALL",
                    "SPU_IDS",
                    "SKU_IDS"
                  ],
                  "description": "商品范围"
                },
                "ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "description": "正整数ID，以字符串传递",
                    "pattern": "^[1-9][0-9]{0,18}$",
                    "format": "int64-positive"
                  },
                  "minItems": 0,
                  "maxItems": 1000,
                  "uniqueItems": true
                }
              },
              "required": [
                "kind",
                "ids"
              ],
              "additionalProperties": false,
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "kind": {
                        "const": "ALL"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "ids": {
                        "maxItems": 0
                      }
                    }
                  },
                  "else": {
                    "properties": {
                      "ids": {
                        "minItems": 1
                      }
                    }
                  }
                }
              ]
            },
            "audience": {
              "const": "ALL_AUTHENTICATED",
              "description": "首期仅有效登录会员"
            },
            "couponPolicy": {
              "type": "string",
              "enum": [
                "EXCLUSIVE",
                "ALLOW_ONE"
              ],
              "description": "是否允许一张指定券"
            },
            "priority": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000,
              "description": "同价且资源数相同时优先级越大越优先"
            },
            "startsAtEpochMs": {
              "type": "string",
              "description": "UTC epoch毫秒，十进制字符串",
              "pattern": "^[1-9][0-9]{0,18}$",
              "format": "int64-positive"
            },
            "endsAtEpochMs": {
              "type": "string",
              "description": "UTC epoch毫秒，十进制字符串",
              "pattern": "^[1-9][0-9]{0,18}$",
              "format": "int64-positive"
            },
            "globalUseLimit": {
              "anyOf": [
