<view class="container">
 <view class="card"><view class="title">会员登录</view><view class="description">使用手机号和密码登录会员账号。</view>
 <view wx:if="{{!ready}}" class="notice">会员服务暂未启用，请联系服务方。</view>
 <label class="field">手机号<input type="text" maxlength="21" value="{{mobile}}" data-field="mobile" bindinput="input" placeholder="请输入手机号" disabled="{{loading}}"/></label>
 <label class="field">密码<input password="{{true}}" value="{{password}}" data-field="password" bindinput="input" placeholder="至少10字符，最多72字节" disabled="{{loading}}"/></label>
 <button type="primary" bindtap="submit" loading="{{loading}}" disabled="{{loading || !ready}}">登录</button>
 <view wx:if="{{error}}" class="error">{{error}}</view><view wx:if="{{success}}" class="success">{{success}}</view>
 </view>
</view>
