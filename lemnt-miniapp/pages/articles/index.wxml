<view class="container">
  <view class="title">商城文章</view>
  <view wx:if="{{!ready}}">服务暂未启用</view>
  <view wx:if="{{categoryError}}" class="error">分类读取失败：{{categoryError}}</view>
  <view wx:if="{{error}}" class="error">{{error}}</view>
  <picker range="{{categories}}" range-key="name" value="{{categoryIndex}}" bindchange="category" disabled="{{loading}}"><view>分类：{{categories[categoryIndex].name}}</view></picker>
  <button bindtap="reload" loading="{{loading}}" disabled="{{loading || !ready}}">刷新文章及分类</button>
  <view wx:if="{{!loading &amp;&amp; !rows.length}}">暂无文章</view>
  <view wx:for="{{rows}}" wx:key="id" class="card">
    <image wx:if="{{item.picUrl}}" src="{{item.picUrl}}" mode="aspectFit" style="width:100%;height:240rpx"/>
    <view class="subtitle">{{item.title}}</view><view>{{item.introduction}}</view><view>{{item.createTime}}</view>
    <button data-id="{{item.id}}" bindtap="read" disabled="{{loading}}">阅读全文</button>
  </view>
  <view>第{{pageNum}}页 · 共{{total}}篇</view>
  <button data-delta="-1" bindtap="page" disabled="{{loading || pageNum === 1}}">上一页</button>
  <button data-delta="1" bindtap="page" disabled="{{loading || pageNum * 20 >= total}}">下一页</button>
</view>
