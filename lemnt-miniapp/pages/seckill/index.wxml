<view class="container"><view class="title">限时秒杀</view><view wx:if="{{!ready}}" class="notice">营销服务暂未启用。</view><view wx:if="{{error}}" class="error">{{error}}</view><button bindtap="reload" loading="{{loading}}" disabled="{{loading || !ready}}">刷新秒杀</button><view wx:if="{{!configs.length && !loading}}" class="card">暂无秒杀时段</view><view class="row"><button wx:for="{{configs}}" wx:key="id" data-id="{{item.id}}" bindtap="selectConfig" disabled="{{loading}}" type="{{item.id === configId ? 'primary' : 'default'}}">{{item.name}} {{item.startTime}}-{{item.endTime}}</button></view><view wx:if="{{!rows.length && !loading && configId}}" class="card">该时段暂无进行中的秒杀活动</view><view wx:for="{{rows}}" wx:key="id" class="card"><view class="subtitle">{{item.name}}</view><view>{{item.spuName}}</view><view wx:if="{{item.seckillPrice}}">秒杀价 {{item.seckillPrice}} 元<text wx:if="{{item.marketPrice}}">（原价 {{item.marketPrice}} 元）</text></view><view class="description">剩余库存 {{item.stock}} / {{item.totalStock}}</view><button type="primary" data-id="{{item.id}}" bindtap="open" disabled="{{loading || item.stock === 0}}">{{item.stock === 0 ? '已抢光' : '查看详情'}}</button></view><view wx:if="{{total}}">第{{pageNum}}页 · 共{{total}}条</view><view class="row"><button data-delta="-1" bindtap="page" disabled="{{loading || pageNum === 1}}">上一页</button><button data-delta="1" bindtap="page" disabled="{{loading || pageNum * 20 >= total}}">下一页</button></view></view>
