<view class="container"><view class="title">浏览足迹</view><view wx:if="{{error}}" class="error">{{error}}</view><view wx:if="{{!ready}}">服务暂未启用</view><button wx:if="{{!loggedIn}}" bindtap="login">登录后查看</button><block wx:else><button bindtap="load" loading="{{loading}}" disabled="{{loading}}">刷新</button><button bindtap="clear" disabled="{{loading}}">清空足迹</button><view wx:if="{{!loading &amp;&amp; !rows.length}}">暂无记录</view><button bindtap="selectAll" disabled="{{loading || !rows.length}}">全选/取消当前页</button><button bindtap="removeSelected" disabled="{{loading || !selected.length}}">批量删除足迹</button><checkbox-group bindchange="selection"><view wx:for="{{rows}}" wx:key="id" class="card"><label><checkbox value="{{item.spuId}}" checked="{{item.checked}}" disabled="{{loading}}"/>选择此商品</label><image wx:if="{{item.picUrl}}" src="{{item.picUrl}}" style="width:120rpx;height:120rpx"/><view>{{item.spuName || '商品资料不可用'}}</view><view wx:if="{{item.price}}">¥{{item.price}}</view><view>{{item.createTime}}</view><button data-id="{{item.spuId}}" bindtap="product" disabled="{{loading}}">查看商品</button><button data-id="{{item.spuId}}" bindtap="remove" disabled="{{loading}}">删除足迹</button></view></checkbox-group><view class="row"><button data-delta="-1" bindtap="page" disabled="{{loading || pageNum === 1}}">上一页</button><view>{{pageNum}}页 · 共{{total}}条</view><button data-delta="1" bindtap="page" disabled="{{loading || pageNum * 20 >= total}}">下一页</button></view></block></view>