<view class="container"><view class="title">拼团详情</view><view wx:if="{{!ready}}" class="notice">营销服务暂未启用。</view><view wx:if="{{error}}" class="error">{{error}}</view><button bindtap="reload" loading="{{loading}}" disabled="{{loading || !ready}}">刷新详情</button><block wx:if="{{activity}}"><view class="card"><view class="subtitle">{{activity.name}}</view><view>{{activity.userSize}}人成团 · 已成团 {{activity.successCount}} 组</view><view class="description">{{activity.startTime}} 至 {{activity.endTime}}</view><view class="description">限购：总 {{activity.totalLimitCount}} 件，单次 {{activity.singleLimitCount}} 件</view></view><view wx:for="{{activity.products}}" wx:key="skuId" class="card"><view>SKU {{item.skuId}}</view><view>拼团价 {{item.combinationPrice}} 元</view></view><view wx:if="{{address}}" class="description">收货地址：{{address.label}}</view><view wx:if="{{order}}" class="success">订单已创建：{{order.orderNo}}，应付 {{order.totalAmount}} 元。支付渠道尚未接通。</view><button type="primary" bindtap="join" disabled="{{loading}}">发起拼团</button><view class="subtitle">正在开团</view><view wx:if="{{!heads.length}}" class="card">暂无进行中的团，发起第一个团吧</view><view wx:for="{{heads}}" wx:key="id" class="card" data-id="{{item.id}}" bindtap="openRecord"><view>{{item.nickname || '会员'}} 的团 · {{item.userCount}}/{{item.userSize}} 人</view><view class="description">到期时间 {{item.expireTime}}</view><button size="mini" data-head="{{item.id}}" catchtap="join" disabled="{{loading}}">参团</button></view></block><navigator url="/pages/combination/index">返回拼团列表</navigator></view>
