<view class="container"><view class="title">砍价活动</view><view wx:if="{{!ready}}" class="notice">营销服务暂未启用。</view><view wx:if="{{error}}" class="error">{{error}}</view><view class="row"><button bindtap="reload" loading="{{loading}}" disabled="{{loading || !ready}}">刷新砍价</button><button bindtap="records" disabled="{{loading}}">我的砍价</button></view><view wx:if="{{!rows.length && !loading}}" class="card">暂无进行中的砍价活动</view><view wx:for="{{rows}}" wx:key="id" class="card"><view class="subtitle">{{item.name}}</view><view>{{item.spuName}}</view><view>{{item.bargainFirstPrice}} 元起，最低 {{item.bargainMinPrice}} 元<text wx:if="{{item.skuPrice}}">（原价 {{item.skuPrice}} 元）</text></view><view class="description">{{item.helpMaxCount}} 人助力成功 · 已有 {{item.successCount}} 人成功</view><view class="description">{{item.startTime}} 至 {{item.endTime}}</view><button type="primary" data-id="{{item.id}}" bindtap="open" disabled="{{loading || item.stock === 0}}">{{item.stock === 0 ? '已抢光' : '参与砍价'}}</button></view><view wx:if="{{total}}">第{{pageNum}}页 · 共{{total}}条</view><view class="row"><button data-delta="-1" bindtap="page" disabled="{{loading || pageNum === 1}}">上一页</button><button data-delta="1" bindtap="page" disabled="{{loading || pageNum * 20 >= total}}">下一页</button></view></view>
