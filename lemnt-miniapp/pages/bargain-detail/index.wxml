<view class="container"><view class="title">砍价详情</view><view wx:if="{{!ready}}" class="notice">营销服务暂未启用。</view><view wx:if="{{error}}" class="error">{{error}}</view><button bindtap="reload" loading="{{loading}}" disabled="{{loading || !ready}}">刷新详情</button><block wx:if="{{activity}}"><view class="card"><view class="subtitle">{{activity.name}}</view><view>{{activity.spuName}}</view><view>{{activity.bargainFirstPrice}} 元起，最低 {{activity.bargainMinPrice}} 元</view><view class="description">{{activity.helpMaxCount}} 人助力成功 · 已有 {{activity.successCount}} 人成功</view><view class="description">剩 {{activity.stock}} / {{activity.totalStock}} 件 · {{activity.startTime}} 至 {{activity.endTime}}</view></view><button type="primary" bindtap="start" disabled="{{loading || activity.stock === 0}}">{{activity.stock === 0 ? '已抢光' : '发起砍价'}}</button></block><block wx:if="{{detail}}"><view class="card"><view class="subtitle">{{detail.activity.name}}</view><view>当前价 {{detail.record.bargainPrice}} 元（原 {{detail.record.bargainFirstPrice}} 元）</view><view class="description">状态：{{detail.record.status === 2 ? '砍价成功' : detail.record.status === 3 ? '砍价失败' : '砍价中'}}</view><view wx:if="{{detail.record.orderId}}" class="description">订单编号 {{detail.record.orderId}}</view><button type="primary" bindtap="help" disabled="{{loading || detail.helped || detail.record.status !== 1}}">{{detail.helped ? '您已助力' : detail.record.status === 1 ? '帮 TA 砍一刀' : '已结束'}}</button><view wx:if="{{address}}" class="description">收货地址：{{address.label}}</view><view wx:if="{{order}}" class="success">订单已创建：{{order.orderNo}}，应付 {{order.totalAmount}} 元。支付渠道尚未接通。</view><button wx:if="{{detail.record.status === 2}}" type="primary" bindtap="buy" disabled="{{loading || detail.record.orderId}}">{{detail.record.orderId ? '已下单' : '立即购买'}}</button></view><view class="subtitle">助力记录</view><view wx:if="{{!detail.helps.length}}" class="card">还没有人助力</view><view wx:for="{{detail.helps}}" wx:key="id" class="card"><view>会员 {{item.userId}} 砍掉 {{item.reducePrice}} 元</view></view></block><navigator url="/pages/bargain/index">返回砍价活动</navigator></view>
