<view class="container"><view class="title">商城</view><view class="row"><navigator url="/pages/articles/index">商城文章</navigator><navigator url="/pages/index/index">购物车</navigator><navigator url="/pages/coupons/index">领券中心</navigator><navigator url="/pages/member/index">会员中心</navigator></view><view wx:if="{{!ready}}" class="notice">商城服务暂未启用。</view><view class="card"><label class="field">搜索商品<input value="{{name}}" maxlength="200" bindinput="input" placeholder="输入商品名称" disabled="{{loading}}"/></label><picker range="{{categories}}" range-key="name" value="{{categoryIndex}}" bindchange="category" disabled="{{loading}}"><view class="field">分类：{{categories[categoryIndex].name}}（点击选择）</view></picker><button type="primary" bindtap="search" disabled="{{loading || !ready}}" loading="{{loading}}">搜索 / 刷新</button></view><view wx:if="{{error}}" class="error">{{error}}</view><view wx:if="{{!rows.length &amp;&amp; !loading}}" class="card">暂无可展示商品。</view><view wx:for="{{rows}}" wx:key="id" class="card"><image wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFit" style="width:100%;height:300rpx"/><view class="subtitle">{{item.name}}</view><view>¥{{item.minPrice}}{{item.minPrice !== item.maxPrice ? ' ～ ' + item.maxPrice : ''}}</view><view class="description">{{item.available ? '有货，具体库存以结算核验为准' : '暂时缺货'}}</view><button data-id="{{item.id}}" bindtap="product">查看商品与规格</button></view><view>第{{pageNum}}页 · 共{{total}}件商品</view><view class="row"><button data-delta="-1" bindtap="page" disabled="{{loading || pageNum === 1}}">上一页</button><button data-delta="1" bindtap="page" disabled="{{loading || pageNum * 20 >= total}}">下一页</button></view></view>
