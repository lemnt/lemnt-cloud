.container {
  padding: 24rpx;
}
.title {
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}
.description {
  color: #666;
  font-size: 26rpx;
  margin: 8rpx 0;
}
.notice {
  color: #999;
  font-size: 26rpx;
  margin: 16rpx 0;
}
.error {
  color: #c62828;
  margin: 16rpx 0;
}
.carousel {
  height: 360rpx;
  margin-bottom: 24rpx;
}
.carousel-img {
  width: 100%;
  height: 360rpx;
  border-radius: 12rpx;
}
.image {
  width: 100%;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
}
.block-title {
  font-size: 32rpx;
  font-weight: 600;
  margin: 24rpx 0 8rpx;
}
.notice-bar {
  background: #fff7e6;
  padding: 16rpx;
  border-radius: 8rpx;
  margin-bottom: 24rpx;
}
.grid {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 24rpx;
}
.grid-cell {
  width: 25%;
  text-align: center;
  font-size: 24rpx;
  padding: 12rpx 0;
}
.grid-icon {
  width: 72rpx;
  height: 72rpx;
}
.divider {
  height: 1rpx;
  background: #eee;
  margin: 24rpx 0;
}
