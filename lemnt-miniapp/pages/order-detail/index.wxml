<view class="container">
  <view wx:if="{{!ready}}" class="notice">会员服务暂未启用。</view>
  <view wx:if="{{error}}" class="error">{{error}}</view>
  <button wx:if="{{!loggedIn}}" bindtap="login">会员登录</button>
  <block wx:if="{{loggedIn}}">
    <view wx:if="{{order}}" class="card">
      <view class="title">订单 {{order.orderNo}}</view>
      <view class="list-row">状态：{{order.statusLabel}}<text wx:if="{{order.activeRefund}}" class="tag">售后中</text></view>
      <view class="list-row" wx:if="{{order.createTime}}">下单时间：{{order.createTime}}</view>
      <view class="list-row">实付 ￥{{order.totalAmount}}</view>
      <view wx:for="{{order.items}}" wx:for-item="row" wx:key="orderItemId" class="list-row">
        <image wx:if="{{row.picUrl}}" src="{{row.picUrl}}" class="thumb" mode="aspectFill"/>
        <text class="item-name">{{row.spuName || row.productName}} ×{{row.quantity}}</text>
        <text>￥{{row.lineAmount}}</text>
        <view class="description" wx:if="{{row.refundedQuantity != null}}">已退 {{row.refundedQuantity}} 件，可申请 {{row.refundableQuantity}} 件</view>
        <view class="description" wx:if="{{row.specs && row.specs.length}}">规格：<text wx:for="{{row.specs}}" wx:for-item="p" wx:key="specValueId">{{p.specName}} {{p.specValueName}} </text></view>
      </view>
      <view class="row">
        <button wx:if="{{order.canPay}}" type="primary" size="mini" bindtap="goCashier">去支付</button>
        <button wx:if="{{order.canCancel}}" size="mini" bindtap="cancel">取消订单</button>
        <button wx:if="{{order.canReceive}}" size="mini" bindtap="receive">确认收货</button>
        <button wx:if="{{order.canComment}}" size="mini" bindtap="goComment">去评价</button>
        <button wx:if="{{order.canAfterSale}}" size="mini" bindtap="goAfterSale">申请售后</button>
      </view>
    </view>
    <view wx:if="{{order && order.pickUpVerifyCode}}" class="card">
      <view class="subtitle">自提信息</view>
      <view class="list-row">门店：{{order.pickUpStoreName}}</view>
      <view class="list-row" wx:if="{{order.pickUpStoreAddress}}">{{order.pickUpStoreAddress}}</view>
      <view class="list-row" wx:if="{{order.pickUpStorePhone}}">电话：{{order.pickUpStorePhone}}</view>
      <view class="list-row">核销码：{{order.pickUpVerifyCode}}</view>
      <view class="description">请到店出示核销码</view>
    </view>
    <view wx:if="{{order && order.shipment}}" class="card">
      <view class="subtitle">物流信息</view>
      <view class="list-row">{{order.shipment.carrierCode}} {{order.shipment.trackingNo}}</view>
      <view class="list-row">{{order.shipment.recipientName}} {{order.shipment.phone}}</view>
      <view class="list-row">{{order.shipment.address}}</view>
      <view class="list-row" wx:if="{{order.shipment.shippedAt}}">发货：{{order.shipment.shippedAt}}</view>
      <view class="list-row" wx:if="{{order.shipment.receivedAt}}">收货：{{order.shipment.receivedAt}}</view>
      <button bindtap="toggleTracks" disabled="{{loading}}">{{showTracks ? '收起轨迹' : '查看物流轨迹'}}</button>
      <view wx:if="{{showTracks}}">
        <view wx:if="{{!tracks.length}}" class="description">暂无轨迹</view>
        <view wx:for="{{tracks}}" wx:key="time" class="list-row">{{item.time}} {{item.description}}</view>
      </view>
    </view>
    <view wx:if="{{quotaError}}" class="error">{{quotaError}}</view>
    <view wx:if="{{promotionError}}" class="error">{{promotionError}}，请刷新重试</view>
    <view wx:if="{{promotion}}" class="card">
      <view class="subtitle">订单优惠</view>
      <view wx:if="{{promotion.snapshotStatus === 'LEGACY_PARTIAL'}}" class="description">历史分摊信息不完整，未知值未补零</view>
      <view class="list-row">商品优惠 ￥{{promotion.summary.discountAmount == null ? '未记录' : promotion.summary.discountAmount}}</view>
      <view class="list-row">运费优惠 ￥{{promotion.summary.deliveryDiscountPrice == null ? '未记录' : promotion.summary.deliveryDiscountPrice}}</view>
      <view class="list-row">调价差额 ￥{{promotion.summary.adjustmentAmount == null ? '未记录' : promotion.summary.adjustmentAmount}}</view>
      <view wx:for="{{promotion.promotions}}" wx:key="viewKey" class="list-row">{{item.promotionName || '名称未记录'}}：￥{{item.discountAmount == null ? '未记录' : item.discountAmount}}<view wx:for="{{item.items}}" wx:for-item="allocation" wx:key="viewKey" class="description">明细 {{allocation.orderItemId}} · 商品优惠 ￥{{allocation.discountAmount}} · 运费优惠 ￥{{allocation.deliveryDiscountPrice}}</view></view>
    </view>
    <navigator url="/pages/order-list/index">返回订单列表</navigator>
  </block>
</view>
