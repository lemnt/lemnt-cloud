<view class="container"><view class="title">秒杀详情</view><view wx:if="{{!ready}}" class="notice">营销服务暂未启用。</view><view wx:if="{{error}}" class="error">{{error}}</view><button bindtap="reload" loading="{{loading}}" disabled="{{loading || !ready}}">刷新详情</button><block wx:if="{{activity}}"><view class="card"><view class="subtitle">{{activity.name}}</view><view>活动时间 {{activity.startTime}} 至 {{activity.endTime}}</view><view class="description">限购：总 {{activity.totalLimitCount}} 件，单次 {{activity.singleLimitCount}} 件</view><view class="description">剩余活动库存 {{activity.stock}} / {{activity.totalStock}}</view></view><view wx:for="{{activity.products}}" wx:key="skuId" class="card"><view>SKU {{item.skuId}}</view><view>秒杀价 {{item.seckillPrice}} 元</view><view class="description">剩余 {{item.stock}} 件</view></view><button type="primary" bindtap="order" disabled="{{loading || activity.stock === 0}}">{{activity.stock === 0 ? '已抢光' : '立即抢购'}}</button></block><navigator url="/pages/seckill/index">返回秒杀列表</navigator></view>
