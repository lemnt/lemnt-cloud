<view class="container"><view class="title">优惠券</view><view wx:if="{{!ready}}" class="notice">营销服务暂未启用。</view><view wx:if="{{error}}" class="error">{{error}}</view><view wx:if="{{success}}" class="success">{{success}}</view><button wx:if="{{!loggedIn}}" bindtap="login">登录后领券 / 查看我的优惠券</button><block wx:if="{{loggedIn}}"><view class="row"><button data-mode="center" bindtap="mode" disabled="{{loading}}">领券中心</button><button data-mode="wallet" bindtap="mode" disabled="{{loading}}">我的优惠券</button></view><button bindtap="reload" loading="{{loading}}" disabled="{{loading || !ready}}">刷新优惠券</button><view wx:if="{{!rows.length &amp;&amp; !loading}}" class="card">{{mode === 'center' ? '暂无开放领取的优惠券' : '暂未持有优惠券'}}</view><view wx:for="{{rows}}" wx:key="id" class="card"><view class="subtitle">{{item.name}}</view><view>满{{item.threshold}}元 · {{item.rule}}</view><view class="description">{{item.validFrom}} 至 {{item.validUntil}}</view><block wx:if="{{mode === 'center'}}"><view>剩余名额{{item.remaining}} · 每人限领{{item.takeLimitCount}}张</view><button type="primary" data-id="{{item.id}}" bindtap="claim" disabled="{{loading || !item.claimable}}">{{item.claimable ? '立即领取' : '当前不可领取'}}</button></block><block wx:else=""><view>状态：{{item.status === 'LOCKED' ? '订单已锁定' : item.status === 'USED' ? '已使用' : item.status === 'EXPIRED' ? '已过期' : item.usable ? '当前可用' : '当前不可用（请核对原券有效期）'}}</view><view class="description">优惠券编号{{item.couponId}}，最终优惠以结算核验为准。</view></block></view><view>第{{pageNum}}页 · 共{{total}}条</view><view class="row"><button data-delta="-1" bindtap="page" disabled="{{loading || pageNum === 1}}">上一页</button><button data-delta="1" bindtap="page" disabled="{{loading || pageNum * 20 >= total}}">下一页</button></view></block><navigator url="/pages/index/index" open-type="reLaunch">去购物车使用优惠券</navigator><navigator url="/pages/store/index" open-type="reLaunch">继续选购商品</navigator></view>
