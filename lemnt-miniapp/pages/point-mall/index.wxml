<view class="container"><view class="title">积分商城</view><view wx:if="{{!ready}}" class="notice">营销服务暂未启用。</view><view wx:if="{{error}}" class="error">{{error}}</view><button bindtap="reload" loading="{{loading}}" disabled="{{loading || !ready}}">刷新积分商城</button><view wx:if="{{!rows.length && !loading}}" class="card">暂无可兑换商品</view><view wx:for="{{rows}}" wx:key="id" class="card"><view class="subtitle">{{item.spuName}}</view><view wx:if="{{item.point != null}}">{{item.point}} 积分<text wx:if="{{item.price !== '0.00'}}"> + {{item.price}} 元</text></view><view class="description">剩余 {{item.stock}} / {{item.totalStock}} 件</view><button type="primary" data-id="{{item.id}}" bindtap="open" disabled="{{loading || item.stock === 0}}">{{item.stock === 0 ? '已兑完' : '查看详情'}}</button></view><view wx:if="{{total}}">第{{pageNum}}页 · 共{{total}}条</view><view class="row"><button data-delta="-1" bindtap="page" disabled="{{loading || pageNum === 1}}">上一页</button><button data-delta="1" bindtap="page" disabled="{{loading || pageNum * 20 >= total}}">下一页</button></view></view>
