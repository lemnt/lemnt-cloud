<view class="container"><view class="title">拼团活动</view><view wx:if="{{!ready}}" class="notice">营销服务暂未启用。</view><view wx:if="{{error}}" class="error">{{error}}</view><view class="row"><button bindtap="reload" loading="{{loading}}" disabled="{{loading || !ready}}">刷新拼团</button><button bindtap="records" disabled="{{loading}}">我的拼团</button></view><view wx:if="{{!rows.length && !loading}}" class="card">暂无进行中的拼团活动</view><view wx:for="{{rows}}" wx:key="id" class="card"><view class="subtitle">{{item.name}}</view><view>{{item.spuName}}</view><view wx:if="{{item.combinationPrice}}">拼团价 {{item.combinationPrice}} 元<text wx:if="{{item.marketPrice}}">（原价 {{item.marketPrice}} 元）</text></view><view class="description">{{item.userSize}}人成团 · {{item.startTime}} 至 {{item.endTime}}</view><button type="primary" data-id="{{item.id}}" bindtap="open" disabled="{{loading}}">查看详情</button></view><view wx:if="{{total}}">第{{pageNum}}页 · 共{{total}}条</view><view class="row"><button data-delta="-1" bindtap="page" disabled="{{loading || pageNum === 1}}">上一页</button><button data-delta="1" bindtap="page" disabled="{{loading || pageNum * 20 >= total}}">下一页</button></view></view>
