.container { padding: 24rpx; }
.title { font-size: 36rpx; font-weight: 600; margin-bottom: 16rpx; }
.card { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 24rpx; }
.subtitle { font-size: 30rpx; font-weight: 500; margin-bottom: 12rpx; }
.input { border: 1rpx solid #ddd; border-radius: 8rpx; padding: 12rpx; margin: 8rpx 0; }
.list-row { border-bottom: 1rpx solid #f0f0f0; padding: 12rpx 0; }
.description { color: #666; font-size: 24rpx; }
.positive { color: #2e7d32; }
.negative { color: #c62828; }
.success { color: #2e7d32; margin: 12rpx 0; }
.error { color: #c62828; margin: 12rpx 0; }
