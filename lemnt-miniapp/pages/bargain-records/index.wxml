<view class="container"><view class="title">我的砍价</view><view wx:if="{{!ready}}" class="notice">营销服务暂未启用。</view><view wx:if="{{error}}" class="error">{{error}}</view><button wx:if="{{!loggedIn}}" bindtap="login">登录后查看砍价记录</button><block wx:else=""><button bindtap="reload" loading="{{loading}}" disabled="{{loading}}">刷新砍价记录</button><view wx:if="{{!rows.length && !loading}}" class="card">暂无砍价记录</view><view wx:for="{{rows}}" wx:key="id" class="card" data-id="{{item.id}}" bindtap="open"><view class="subtitle">{{item.spuName}}</view><view>{{item.bargainPrice}} 元（原 {{item.bargainFirstPrice}} 元）</view><view class="description">状态：{{item.status === 2 ? '砍价成功' : item.status === 3 ? '砍价失败' : '砍价中'}}</view></view><view wx:if="{{total}}">第{{pageNum}}页 · 共{{total}}条</view><view class="row"><button data-delta="-1" bindtap="page" disabled="{{loading || pageNum === 1}}">上一页</button><button data-delta="1" bindtap="page" disabled="{{loading || pageNum * 20 >= total}}">下一页</button></view></block><navigator url="/pages/bargain/index">返回砍价活动</navigator></view>
