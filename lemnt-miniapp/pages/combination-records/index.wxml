<view class="container"><view class="title">我的拼团</view><view wx:if="{{!ready}}" class="notice">营销服务暂未启用。</view><view wx:if="{{error}}" class="error">{{error}}</view><button wx:if="{{!loggedIn}}" bindtap="login">登录后查看拼团记录</button><block wx:else=""><block wx:if="{{detail}}"><view class="card"><view class="subtitle">{{detail.head.spuName}}</view><view>{{'团长：' + (detail.head.nickname || '会员')}} · {{detail.head.userCount}}/{{detail.head.userSize}} 人</view><view class="description">状态：{{detail.head.status === 1 ? '拼团成功' : detail.head.status === 2 ? '拼团失败' : '进行中'}}</view><view wx:if="{{detail.orderId}}" class="description">我的订单编号 {{detail.orderId}}</view></view><view wx:for="{{detail.members}}" wx:key="id" class="card"><view>{{item.nickname || '会员'}} · {{item.count}} 件</view><view class="description">{{item.status === 1 ? '已参团成功' : item.status === 2 ? '拼团失败' : '已参团'}}</view></view><button bindtap="loadDetail">刷新记录</button></block><block wx:else=""><button bindtap="reload" loading="{{loading}}" disabled="{{loading}}">刷新拼团记录</button><view wx:if="{{!rows.length && !loading}}" class="card">暂无拼团记录</view><view wx:for="{{rows}}" wx:key="id" class="card"><view class="subtitle">{{item.spuName}}</view><view>{{item.userCount}}/{{item.userSize}} 人 · {{item.combinationPrice}} 元</view><view class="description">状态：{{item.status === 1 ? '拼团成功' : item.status === 2 ? '拼团失败' : '进行中'}}</view><view class="description">到期时间 {{item.expireTime}}</view></view><view wx:if="{{total}}">第{{pageNum}}页 · 共{{total}}条</view><view class="row"><button data-delta="-1" bindtap="page" disabled="{{loading || pageNum === 1}}">上一页</button><button data-delta="1" bindtap="page" disabled="{{loading || pageNum * 20 >= total}}">下一页</button></view></block></block><navigator url="/pages/combination/index">返回拼团活动</navigator></view>
