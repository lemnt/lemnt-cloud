<view class="container">
 <view class="card"><view class="title">会员中心</view><navigator url="/pages/coupons/index?mode=wallet">我的优惠券 / 领券中心</navigator><view wx:if="{{!ready}}" class="notice">会员服务暂未启用。</view><view wx:if="{{error}}" class="error">{{error}}</view><view wx:if="{{success}}" class="success">{{success}}</view><button wx:if="{{!loggedIn}}" bindtap="login">登录 / 注册会员</button>
 <block wx:if="{{loggedIn}}"><button bindtap="reload" loading="{{loading}}" disabled="{{loading}}">刷新资料</button><view wx:if="{{profile}}"><view class="subtitle">{{profile.nickname}}</view><view>会员编号：{{profile.memberNo}}</view><view>积分 {{profile.points}} · 经验 {{profile.experience}}</view></view><view class="row"><button data-page="member-addresses" bindtap="go">地址簿</button><button data-page="member-benefits" bindtap="go">会员权益</button></view></block></view>
 <block wx:if="{{loggedIn &amp;&amp; profile}}">
 <view class="card"><view class="subtitle">个人资料</view><label class="field">昵称<input value="{{form.nickname}}" maxlength="80" data-field="nickname" bindinput="input" disabled="{{loading}}"/></label><label class="field">邮箱<input value="{{form.email}}" maxlength="254" data-field="email" bindinput="input" disabled="{{loading}}"/></label><label class="field">头像HTTPS地址<input value="{{form.avatar}}" maxlength="500" data-field="avatar" bindinput="input" disabled="{{loading}}"/></label><picker mode="selector" range="{{['未知','男','女']}}" value="{{form.sex}}" bindchange="sex" disabled="{{loading}}"><view class="field">性别：{{form.sex === 1 ? '男' : form.sex === 2 ? '女' : '未知'}}（点击选择）</view></picker><picker mode="date" value="{{form.birthday}}" bindchange="birthday" disabled="{{loading}}"><view class="field">生日：{{form.birthday || '点击选择'}}</view></picker><button type="primary" bindtap="save" disabled="{{loading}}">保存资料</button></view>
 <view class="card"><view class="subtitle">修改密码</view><view class="description">修改后所有登录会话失效。未设置密码的会员可在登录页使用短信找回密码。</view><label class="field">原密码<input password="{{true}}" value="{{oldPassword}}" data-field="oldPassword" bindinput="input" disabled="{{loading}}"/></label><label class="field">新密码<input password="{{true}}" value="{{newPassword}}" data-field="newPassword" bindinput="input" disabled="{{loading}}" placeholder="至少10字符，最多72字节"/></label><button bindtap="password" disabled="{{loading}}">修改密码并退出</button></view>
 <view class="card"><view class="subtitle">变更手机号</view><view>当前手机号：{{profile.mobile || '未绑定'}}</view><block wx:if="{{profile.mobile}}"><button bindtap="sendOld" disabled="{{loading}}">向原手机号发送验证码</button><label class="field">原手机号验证码<input type="number" maxlength="6" value="{{oldCode}}" data-field="oldCode" bindinput="input" disabled="{{loading}}"/></label></block><label class="field">新手机号<input value="{{mobile}}" data-field="mobile" bindinput="input" disabled="{{loading}}" maxlength="21"/></label><button bindtap="sendNew" disabled="{{loading}}">向新手机号发送验证码</button><label class="field">新手机号验证码<input type="number" maxlength="6" value="{{code}}" data-field="code" bindinput="input" disabled="{{loading}}"/></label><button bindtap="mobile" disabled="{{loading}}">确认换绑并退出</button><button open-type="getPhoneNumber" bindgetphonenumber="wechatMobile" disabled="{{loading}}">使用微信核验手机号并换绑</button></view>
 <view class="card"><view class="subtitle">微信与登录安全</view><view>已绑定：{{bindings.length ? bindings : '无'}}</view><button bindtap="bindWechat" disabled="{{loading}}">绑定当前微信</button><button bindtap="unbindWechat" disabled="{{loading}}">解绑当前小程序微信</button><button bindtap="refresh" disabled="{{loading}}">刷新登录会话</button></view>
 </block><button wx:if="{{loggedIn}}" bindtap="logout" disabled="{{loading}}">退出登录</button><navigator url="/pages/index/index" open-type="reLaunch">返回商城购物车</navigator>
</view>
