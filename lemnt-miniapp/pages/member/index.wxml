<view class="container">
 <view class="card"><view class="title">会员中心</view><navigator url="/pages/coupons/index?mode=wallet">我的优惠券 / 领券中心</navigator><view wx:if="{{!ready}}" class="notice">会员服务暂未启用。</view><view wx:if="{{error}}" class="error">{{error}}</view><view wx:if="{{success}}" class="success">{{success}}</view><button wx:if="{{!loggedIn}}" bindtap="login">会员登录</button>
 <block wx:if="{{loggedIn}}"><button bindtap="reload" loading="{{loading}}" disabled="{{loading}}">刷新资料</button><view wx:if="{{profile}}"><view class="subtitle">{{profile.nickname}}</view><view>会员编号：{{profile.memberNo}}</view><view>积分 {{profile.points}} · 经验 {{profile.experience}}</view></view><view class="row"><button data-page="member-addresses" bindtap="go">地址簿</button><button data-page="member-benefits" bindtap="go">会员权益</button><button data-page="favorites" bindtap="go">商品收藏</button><button data-page="browse-history" bindtap="go">浏览足迹</button></view><view class="row"><navigator url="/pages/order-list/index">我的订单</navigator><navigator url="/pages/after-sale-list/index">售后中心</navigator></view></block></view>
 <block wx:if="{{loggedIn &amp;&amp; profile}}">
 <view class="card"><view class="subtitle">个人资料</view><label class="field">昵称<input value="{{form.nickname}}" maxlength="80" data-field="nickname" bindinput="input" disabled="{{loading}}"/></label><label class="field">邮箱<input value="{{form.email}}" maxlength="254" data-field="email" bindinput="input" disabled="{{loading}}"/></label><label class="field">头像HTTPS地址<input value="{{form.avatar}}" maxlength="500" data-field="avatar" bindinput="input" disabled="{{loading}}"/></label><picker mode="selector" range="{{['未知','男','女']}}" value="{{form.sex}}" bindchange="sex" disabled="{{loading}}"><view class="field">性别：{{form.sex === 1 ? '男' : form.sex === 2 ? '女' : '未知'}}（点击选择）</view></picker><picker mode="date" value="{{form.birthday}}" bindchange="birthday" disabled="{{loading}}"><view class="field">生日：{{form.birthday || '点击选择'}}</view></picker><button type="primary" bindtap="save" disabled="{{loading}}">保存资料</button></view>
 <view class="card"><view class="subtitle">修改密码</view><view class="description">修改后需要在当前设备重新登录。</view><label class="field">原密码<input password="{{true}}" value="{{oldPassword}}" data-field="oldPassword" bindinput="input" disabled="{{loading}}"/></label><label class="field">新密码<input password="{{true}}" value="{{newPassword}}" data-field="newPassword" bindinput="input" disabled="{{loading}}" placeholder="至少10字符，最多72字节"/></label><button bindtap="password" disabled="{{loading}}">修改密码并退出</button></view>
 <button bindtap="refresh" disabled="{{loading}}">刷新登录会话</button>
 </block><button wx:if="{{loggedIn}}" bindtap="logout" disabled="{{loading}}">退出登录</button><navigator url="/pages/index/index" open-type="reLaunch">返回商城购物车</navigator>
</view>
