<view class="container"><view class="title">积分兑换</view><view wx:if="{{!ready}}" class="notice">营销服务暂未启用。</view><view wx:if="{{error}}" class="error">{{error}}</view><button bindtap="reload" loading="{{loading}}" disabled="{{loading || !ready}}">刷新详情</button><block wx:if="{{activity}}"><view class="card"><view class="subtitle">{{activity.spuName}}</view><view wx:if="{{activity.point != null}}">最低 {{activity.point}} 积分<text wx:if="{{activity.price !== '0.00'}}"> + {{activity.price}} 元</text></view><view class="description">剩余 {{activity.stock}} / {{activity.totalStock}} 件</view></view><view wx:for="{{activity.products}}" wx:key="skuId" class="card"><view>SKU {{item.skuId}}</view><view>{{item.point}} 积分<text wx:if="{{item.price !== '0.00'}}"> + {{item.price}} 元</text></view><view class="description">限兑 {{item.exchangeCount}} 次 · 剩余 {{item.stock}} 件</view></view><view wx:if="{{address}}" class="description">收货地址：{{address.label}}</view><view wx:if="{{order}}" class="success">订单{{order.status === 'PAID' ? '已完成' : '已创建'}}：{{order.orderNo}}，应付 {{order.totalAmount}} 元，消耗积分 {{order.usePoint}}。{{order.status === 'PAID' ? '零元兑换已自动完成。' : '支付渠道尚未接通。'}}</view><button type="primary" bindtap="exchange" disabled="{{loading || activity.stock === 0}}">{{activity.stock === 0 ? '已兑完' : '立即兑换'}}</button></block><navigator url="/pages/point-mall/index">返回积分商城</navigator></view>
