<view class="container"><view class="title">收货地址</view><view wx:if="{{!ready}}" class="notice">会员服务暂未启用。</view><view wx:if="{{error}}" class="error">{{error}}</view><view wx:if="{{success}}" class="success">{{success}}</view><button wx:if="{{!loggedIn}}" bindtap="login">请先登录</button>
<block wx:if="{{loggedIn}}"><view class="row"><button bindtap="reload" loading="{{loading}}" disabled="{{loading}}">刷新地址</button><button type="primary" bindtap="add" disabled="{{loading || !ready}}">新增地址</button></view><view wx:if="{{!rows.length &amp;&amp; !loading}}" class="card">还没有收货地址。</view>
<view wx:for="{{rows}}" wx:key="id" class="card"><view class="subtitle">{{item.name}} {{item.defaultStatus ? '（默认）' : ''}}</view><view>{{item.mobile}}</view><view>{{item.areaName || '区划 ' + item.areaId}} · {{item.detailAddress}}</view><view class="row"><button size="mini" data-id="{{item.id}}" bindtap="edit" disabled="{{loading}}">编辑</button><button size="mini" data-id="{{item.id}}" bindtap="remove" disabled="{{loading}}">删除</button></view></view>
<view wx:if="{{editing}}" class="card"><view class="subtitle">{{editId ? '编辑地址' : '新增地址'}}</view><label class="field">收件人<input value="{{form.name}}" maxlength="80" data-field="name" bindinput="input" disabled="{{loading}}"/></label><label class="field">手机号<input value="{{form.mobile}}" maxlength="21" data-field="mobile" bindinput="input" disabled="{{loading}}"/></label><label class="field">区县行政区划代码<input type="number" value="{{form.areaId}}" maxlength="19" data-field="areaId" bindinput="input" placeholder="如110101，请填写实际所在区县代码" disabled="{{loading}}"/></label><label class="field">详细地址<textarea value="{{form.detailAddress}}" maxlength="500" data-field="detailAddress" bindinput="input" placeholder="街道及门牌号" disabled="{{loading}}"/></label><label class="field">设为默认地址<switch checked="{{form.defaultStatus}}" bindchange="toggle" disabled="{{loading}}"/></label><view class="row"><button type="primary" bindtap="save" disabled="{{loading}}">保存地址</button><button bindtap="cancel" disabled="{{loading}}">取消</button></view></view></block></view>
