<view class="container"><view class="title">会员权益</view><view wx:if="{{!ready}}" class="notice">会员服务暂未启用。</view><view wx:if="{{error}}" class="error">{{error}}</view><view wx:if="{{success}}" class="success">{{success}}</view><button wx:if="{{!loggedIn}}" bindtap="login">请先登录</button><block wx:if="{{loggedIn}}"><button bindtap="reload" loading="{{loading}}" disabled="{{loading}}">刷新权益</button>
<view class="card"><view wx:if="{{profile}}">积分 {{profile.points}} · 经验 {{profile.experience}}</view><view wx:if="{{summary}}">累计签到{{summary.total}}天 · 当前周期连续{{summary.continuous}}天</view><button type="primary" bindtap="sign" disabled="{{loading || summary.signedToday || !ready}}">{{summary.signedToday ? '今日已签到' : '每日签到'}}</button><view wx:if="{{!rules.length}}" class="description">暂未配置签到奖励。</view><view wx:for="{{rules}}" wx:key="day">第{{item.day}}天：{{item.point}}积分 / {{item.experience}}经验</view></view>
<view class="card"><view class="subtitle">等级权益</view><view wx:if="{{!levels.length}}">暂无启用等级。</view><view wx:for="{{levels}}" wx:key="id" class="list-row">{{item.name}} {{profile.levelId === item.id ? '（当前等级）' : ''}}<view class="description">经验门槛{{item.experience}}，支付原价{{item.discountPercent}}%</view></view></view>
<view class="card"><view class="subtitle">会员记录</view><view class="row"><button size="mini" data-kind="points" bindtap="kind" disabled="{{loading}}">积分</button><button size="mini" data-kind="experience" bindtap="kind" disabled="{{loading}}">经验</button><button size="mini" data-kind="signin" bindtap="kind" disabled="{{loading}}">签到</button></view><view wx:if="{{!records.length}}">暂无记录。</view><view wx:for="{{records}}" wx:key="id" class="list-row"><block wx:if="{{kind === 'signin'}}">{{item.signDate}} · 第{{item.day}}天<view>积分+{{item.point}} · 经验+{{item.experience}}</view></block><block wx:else="">{{item.createTime}}<view>变更{{item.delta}} · 余额{{item.balance}}</view><view class="description">{{item.reason}}</view></block></view><view>第{{pageNum}}页 · 共{{total}}条</view><view class="row"><button size="mini" data-delta="-1" bindtap="page" disabled="{{loading || pageNum === 1}}">上一页</button><button size="mini" data-delta="1" bindtap="page" disabled="{{loading || pageNum * 20 >= total}}">下一页</button></view></view>
</block></view>
